{
  "name": "ai-design-system",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "storybook": "bun --cwd apps/storybook dev",
    "tokens:build": "bun --cwd packages/tokens build",
    "tokens:generate": "bun --cwd packages/tokens generate"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "@biomejs/biome": "^1.9.4"
  }
}
