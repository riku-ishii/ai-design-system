{
  "name": "ai-design-system",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "storybook": "bun --cwd apps/storybook dev",
    "tokens:build": "bun --cwd packages/tokens build",
    "tokens:figma": "bun --cwd packages/tokens figma:export",
    "tokens:generate": "bun --cwd packages/tokens generate",
    "figma:validate": "figma connect --dry-run",
    "figma:publish": "figma connect publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@figma/code-connect": "^1.4.8",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
